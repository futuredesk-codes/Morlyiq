  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.3",
    "morgan": "^1.12.1",
    "nodemailer": "^10.0.15",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
