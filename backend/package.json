{
  "name": "morlyiq-backend",
  "version": "1.0.0",
  "description": "Backend API server for MorlyIQ with Express and MongoDB",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed:admin": "node src/scripts/admin/seedSuperAdmin.js",
    "seed:admin-roles": "node src/scripts/admin/seedRoles.js",
    "seed:admin-features": "node src/scripts/admin/seedFeatures.js",
    "seed:admin-cdt": "node src/scripts/admin/seedCdtCodes.js",
    "seed:admin-plans": "node src/scripts/admin/seedPlansAndCoupons.js",
    "seed:client-user": "node src/scripts/client/seedUser.js",
    "seed:client-patients": "node src/scripts/client/seedPatients.js",
    "migrate:clinic-providers": "node src/scripts/client/consolidateClinicProviders.js"
