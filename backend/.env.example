# Server Configuration
PORT=5000
NODE_ENV=

# MongoDB Connection String
MONGODB_URI=

# CORS Allowed Origins
CLIENT_URL=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=

# Admin panel authentication
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRES_IN=
ADMIN_SEED_NAME=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_ORGANIZATION=

# Client panel seed user (npm run seed:client-user)
# Role: Owner | Manager | Front Desk | Billing | Dentist   Clinic: cl1 | cl2
SEED_PRACTICE_NAME=
SEED_USER_NAME=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=


# Email (nodemailer) — staff invitations
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
CLIENT_APP_URL=http://localhost:5173/login
# Base URL is used for client onboarding/payment return links (no /login suffix).
CLIENT_APP_BASE_URL=http://localhost:5173
ADMIN_APP_URL=http://localhost:5174/login
# Due task/follow-up reminders run every minute while the backend is running.
# Emails use SMTP above; ADMIN_APP_URL must point to the deployed Admin panel.
LEAD_REMINDERS_ENABLED=true

# Stripe client onboarding (use test-mode values during development)
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_TEST_MODE_ONLY=true


# Stedi API keys. Keep secrets in the deployment secret manager. You can either
# replace STEDI_API_KEY when changing environments, or configure both mode keys
# once and switch only STEDI_CLAIMS_MODE + STEDI_ERA_MODE.
STEDI_API_KEY=
STEDI_TEST_API_KEY=
STEDI_PRODUCTION_API_KEY=
STEDI_PAYER_SEARCH_URL=https://payers.us.stedi.com/2024-04-01/payers/search
# Payer Network records should be refreshed at least daily; default is 24 hours.
STEDI_PAYER_CACHE_TTL_HOURS=24

# Real-time 270/271 eligibility. Provider values are local/sandbox fallbacks;
# production provider identity should be configured per clinic in the Client Panel.
STEDI_ELIGIBILITY_URL=https://healthcare.us.stedi.com/2026-06-01/eligibility-check
STEDI_ELIGIBILITY_TIMEOUT_MS=30000
# Optional dedicated key; otherwise the active mode key or STEDI_API_KEY is used.
STEDI_ELIGIBILITY_API_KEY=
# Uses the exact synthetic MetLife dental fixture in
# src/config/stediTestEligibilityFixture.js when the patient matches it.
STEDI_ELIGIBILITY_MOCK_ENABLED=false

# 837D dental claims. Allowed values: test | production.
# In production, both mock flags below must be false or the server will refuse
# to start. Claims created in one environment cannot be submitted in another.
STEDI_CLAIMS_MODE=test
STEDI_CLAIM_SUBMISSION_ENABLED=false
STEDI_DENTAL_CLAIMS_URL=https://healthcare.us.stedi.com/2024-04-01/dental-claims/submission
STEDI_CLAIMS_TIMEOUT_MS=30000
# A completed eligibility response older than this is treated as stale at claim submission.
# Missing, failed, partial, or stale eligibility strictly blocks claim submission.
CLAIM_ELIGIBILITY_MAX_AGE_DAYS=30

# Development-only synthetic 837D fixture stored in
# src/config/stediTestClaimFixture.js. It is ignored unless claims mode is test.
# Keep false in production; only secrets and deployment controls belong here.
STEDI_TEST_CLAIM_MOCK_ENABLED=false

# Provider + Claim Payment (835) enrollment automation. Stedi requires a
# production-mode API key even though the resulting enrollment is restricted
# by the backend to the Stedi Test Payer. Never reuse the test claims key here.
STEDI_AUTO_ENROLLMENT_ENABLED=false
STEDI_ENROLLMENT_API_KEY=
STEDI_ENROLLMENT_BASE_URL=https://enrollments.us.stedi.com/2024-09-01
STEDI_ENROLLMENT_PAYER_ID=FRCPB
STEDI_ENROLLMENT_PAYER_ALIAS=STEDITEST
STEDI_ENROLLMENT_TIMEOUT_MS=30000

# 835 ERA discovery, normalized report data, and Stedi-generated PDFs.
# Keep this equal to STEDI_CLAIMS_MODE.
STEDI_ERA_MODE=test
# Optional dedicated key; when blank, the mode-specific key or STEDI_API_KEY is used.
STEDI_ERA_API_KEY=
STEDI_ERA_TRANSACTIONS_URL=https://core.us.stedi.com/2023-08-01/transactions
STEDI_ERA_REPORT_BASE_URL=https://healthcare.us.stedi.com/2024-04-01/change/medicalnetwork/reports/v2
STEDI_ERA_PDF_BASE_URL=https://healthcare.us.stedi.com/2024-04-01/electronic-remittance-advice
STEDI_ERA_TIMEOUT_MS=30000
STEDI_ERA_LIST_LIMIT=50
